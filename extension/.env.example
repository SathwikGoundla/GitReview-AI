# GitReview AI Chrome Extension — environment variables
# Copy this file to .env and fill in values for your environment.
# .env is excluded from version control (see .gitignore).

# Backend URL — no trailing slash
# Development (local FastAPI):
VITE_BACKEND_URL=http://localhost:8000

# Production (Render deployment):
# VITE_BACKEND_URL=https://your-app.onrender.com
