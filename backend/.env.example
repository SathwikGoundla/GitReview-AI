# ============================================================
# GitReview AI — Environment Configuration Example
# Copy to .env and fill in your values. NEVER commit .env.
# ============================================================

# --- Database ---
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/gitreview_ai
DATABASE_URL_SYNC=postgresql://user:password@localhost:5432/gitreview_ai

# --- GitHub OAuth ---
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
GITHUB_REDIRECT_URI=http://localhost:8000/api/auth/callback

# --- Session / Security ---
# 32-byte URL-safe base64-encoded key for Fernet encryption
ENCRYPTION_KEY=your_fernet_key_here
# Secret for itsdangerous CSRF state signing
STATE_SECRET=your_state_secret_here

# --- Google Gemini ---
GEMINI_API_KEY=your_gemini_api_key_here

# --- App ---
APP_ENV=development
DEBUG=true
ALLOWED_ORIGINS=http://localhost:3000,chrome-extension://your_extension_id
SESSION_EXPIRY_HOURS=24

# --- GitHub Actions Integration ---
# Per-repository shared secret (set in GitHub repo Secrets)
# ACTIONS_SHARED_SECRET is validated per-request; not a single env var
