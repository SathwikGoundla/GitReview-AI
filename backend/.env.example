# GitReview AI — Backend Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.

# ── Application ────────────────────────────────────────────────────────────────
APP_ENV=development
DEBUG=false
ALLOWED_ORIGINS=http://localhost:3000,chrome-extension://your-extension-id

# ── Database (Supabase PostgreSQL) ─────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/gitreview_ai
DATABASE_URL_SYNC=postgresql://user:password@host:5432/gitreview_ai

# ── GitHub OAuth ───────────────────────────────────────────────────────────────
GITHUB_CLIENT_ID=your_github_oauth_app_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_app_client_secret
GITHUB_REDIRECT_URI=http://localhost:8000/api/auth/callback

# ── Session Security ───────────────────────────────────────────────────────────
# Generate ENCRYPTION_KEY with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your_fernet_key_here
# Generate STATE_SECRET with: python -c "import secrets; print(secrets.token_hex(32))"
STATE_SECRET=your_state_secret_here
SESSION_EXPIRY_HOURS=24

# ── Google Gemini ──────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ── GitHub Actions Integration ─────────────────────────────────────────────────
# Shared secret used to authenticate GitHub Actions workflow requests.
# Must match GITREVIEW_SHARED_SECRET in your GitHub repository Secrets.
# Generate with: openssl rand -hex 32
# Leave empty to disable the /api/actions/analyze endpoint.
ACTIONS_SHARED_SECRET=your_shared_secret_here
